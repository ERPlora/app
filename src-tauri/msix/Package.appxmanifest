<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX manifest for the Microsoft Store channel.

  scripts/pack-msix.ps1 replaces the __MSIX_*__ tokens at build time with the REAL values from
  Partner Center (the product identity of the reserved «ERPlora» listing):
    __MSIX_IDENTITY_NAME__       → Package/Identity/Name        (e.g. "12345Erplora.ERPlora")
    __MSIX_PUBLISHER__           → Package/Identity/Publisher   (e.g. "CN=xxxxxxxx-...-...")
    __MSIX_PUBLISHER_DISPLAY__   → PublisherDisplayName
    __MSIX_VERSION__             → four-part version (the Store requires revision .0)

  The MSIX is uploaded UNSIGNED: the Store signs it again with its own certificate after
  certification. The exe is packed exactly as `tauri build` leaves it.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="__MSIX_IDENTITY_NAME__"
    Publisher="__MSIX_PUBLISHER__"
    Version="__MSIX_VERSION__"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>ERPlora</DisplayName>
    <PublisherDisplayName>__MSIX_PUBLISHER_DISPLAY__</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <!-- 10.0.17763 = Windows 10 1809, the minimum for modern MSIX + WebView2 Evergreen. -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
    <Resource Language="es-es" />
  </Resources>

  <Applications>
    <Application Id="ERPlora" Executable="ERPlora.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="ERPlora"
        Description="ERPlora Hub — modular POS/ERP for restaurants and salons"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        BackgroundColor="transparent" />
      <Extensions>
        <!-- erplora://: links to a hub and a click on a notice in the Action Center. The .exe/.msi
             register it at install time; the Store copy only has what is declared here. Windows
             starts ERPlora.exe with the link as its argument. -->
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="erplora">
            <uap:DisplayName>ERPlora</uap:DisplayName>
          </uap:Protocol>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- Packaged Win32 app (Tauri): full trust; the real permission model is the runtime's. -->
    <rescap:Capability Name="runFullTrust" />
    <!-- The SaaS and the hub, plus the POS hardware on the LAN (ESC/POS over TCP 9100). -->
    <Capability Name="internetClient" />
    <Capability Name="privateNetworkClientServer" />
  </Capabilities>
</Package>
