# Gradle output of the Android module: `cargo tauri android build` regenerates it.
android/build
android/.gradle
# Copy of the `tauri-android` SDK that Tauri leaves when building: it comes from the `tauri` crate.
android/.tauri
# Output of the Gradle root that runs the Kotlin tests on pull requests. Its config IS source.
android-tests/build
android-tests/.gradle
/target
